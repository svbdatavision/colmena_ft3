# Archivo de configuración de ambiente para FastTrack 3.0 en Databricks
# Copiar este archivo como .env y completar según el entorno.

# ========================================
# ARTEFACTOS DE MODELO (OPCIONAL)
# ========================================
# Carpeta base para resolver artefactos del modelo
# Si no se define, el código intenta rutas por defecto:
#   ./models, /dbfs/models, /dbfs/FileStore/models
MODELS_PATH=/dbfs/FileStore/models

# Override explícito del archivo de modelo (ruta completa o carpeta)
FASTTRACK_MODEL_PATH=

# Override explícito del archivo de transformers (ruta completa o carpeta)
FEATURE_TRANSFORMERS_PATH=

# ========================================
# ALERTAS TEAMS (OPCIONAL)
# ========================================
# Webhook de Teams para notificaciones de inicio/fin del pipeline
TEAMS_WEBHOOK_URL=

# Alias alternativo soportado por el código (si prefieres este nombre)
MSTEAMS_WEBHOOK_URL=

# ========================================
# CARGA DE .ENV (OPCIONAL)
# ========================================
# Si se define, run_daily_pipeline.py intenta cargar este archivo.
DOTENV_PATH=/app/.env